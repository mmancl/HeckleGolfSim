; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Heckle Golf Simulator"
config/version="0.32.8"
run/main_scene="uid://dgyd437dgyv0y"
config/features=PackedStringArray("4.7", "C#", "Mobile")
boot_splash/image="uid://cjp4o151j14xr"
config/icon="uid://bcv0yjfm7ggro"

[autoload]

PhantomCameraManager="*uid://duq6jhf6unyis"
SceneManager="*res://Utils/SceneManager.gd"
EventBus="*res://Utils/EventBus.gd"
GlobalSettings="*res://Utils/Settings/global_settings.gd"
TensionManager="*res://Utils/TensionManager.gd"
LaunchMonitorManager="*res://addons/launch_monitors/launch_monitor_manager.gd"
AnnouncerEngine="*res://addons/announcer/AnnouncerEngine.cs"
MultiplayerManager="*res://Utils/MultiplayerManager.gd"
AchievementManager="*res://Utils/AchievementManager.gd"
PoseDetectionBridge="*res://UI/GolferCamera/pose_detection_bridge.gd"

[display]

window/size/viewport_width=1728
window/size/viewport_height=972
window/stretch/mode="canvas_items"

[dotnet]

project/assembly_name="OpenShotGolf"

[editor_plugins]

enabled=PackedStringArray("res://addons/openfairway/plugin.cfg", "res://addons/phantom_camera/plugin.cfg", "res://addons/sky_3d/plugin.cfg", "res://addons/terrain_3d/plugin.cfg")

[input]

hit={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":72,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
reset={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":0,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":82,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

[physics]

3d/physics_engine="JoltPhysics3D"
common/physics_interpolation=true

[pointing]

emulate_touch_from_mouse=true
emulate_mouse_from_touch=true

[rendering]

textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=0
lights_and_shadows/directional_shadow/size.mobile=1024
lights_and_shadows/positional_shadow/atlas_size.mobile=1024
scaling_3d/scale.mobile=0.8
