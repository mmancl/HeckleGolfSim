layout_mode = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_card_section")

[node name="AttrVBox" type="VBoxContainer" parent="CenterContainer/ModalPanel/MarginContainer/VBoxContainer/ScrollContainer/ScrollVBox/AttributionsCard"]
layout_mode = 2
