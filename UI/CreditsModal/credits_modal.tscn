[node name="HardwareText" type="RichTextLabel" parent="CenterContainer/ModalPanel/MarginContainer/VBoxContainer/ScrollContainer/ScrollVBox/HardwareCard/HardwareVBox"]
layout_mode = 2
theme_override_colors/default_color = Color(0.9, 0.93, 0.96, 1)
theme_override_font_sizes/normal_font_size = 14
bbcode_enabled = true
text = "• [b]Non-Affiliation Disclaimer[/b]: Heckle Golf Simulator is an independent, community-driven, open-source project. It is [b]NOT[/b] affiliated with, endorsed by, sponsored by, authorized by, or in any way officially connected with [b]Square Golf[/b] (SquareGolf Co., Ltd.), [b]GSPro[/b] (FlightPath Golf LLC), [b]Garmin Ltd.[/b], [b]PiTrac[/b], [b]SkyTrak[/b], [b]Bushnell Golf[/b], [b]TrackMan[/b], [b]Foresight Sports[/b], [b]FlightScope[/b], [b]Rapsodo[/b], [b]Full Swing Golf[/b], [b]Uneekor[/b], or any of their respective subsidiaries or affiliates.

• [b]Trademarks & Nominative Fair Use[/b]: All product names, trademarks, logos, registered trademarks, and brand names referenced in this software or documentation are the property of their respective owners. The use of brand names (such as \"Square Golf Launch Monitor\" or \"GSPro Open Connect v1\") is solely for technical identification, compatibility description, and interoperability purposes under nominative fair use principles.

• [b]Clean-Room Interoperability[/b]: Device connectivity in Heckle Golf Simulator utilizes open wireless Bluetooth Low Energy (BLE) GATT protocols and local TCP/IP socket network streams. [b]No proprietary software, binary drivers, decompiled copyrighted source code, firmware, or official manufacturer SDKs are packaged, copied, or distributed with this repository.[/b]"
fit_content = true

[node name="CourseDataCard" type="PanelContainer" parent="CenterContainer/ModalPanel/MarginContainer/VBoxContainer/ScrollContainer/ScrollVBox"]
