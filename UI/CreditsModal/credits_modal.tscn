[node name="ForkText" type="RichTextLabel" parent="CenterContainer/ModalPanel/MarginContainer/VBoxContainer/ScrollContainer/ScrollVBox/ForkCard/ForkVBox"]
layout_mode = 2
theme_override_colors/default_color = Color(0.9, 0.93, 0.96, 1)
theme_override_font_sizes/normal_font_size = 14
bbcode_enabled = true
text = "This simulator was forked and evolved from [b]OpenShotGolf[/b] (by [b]jhauck2[/b]), which provided the foundational architecture for launch monitor connectivity and the realistic Reynolds-number golf ball aerodynamics / rollout physics simulation."
fit_content = true

