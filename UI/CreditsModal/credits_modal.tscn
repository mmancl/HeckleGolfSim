text = "🗺️ Course Geometry & OpenStreetMap Data"

[node name="CourseDataText" type="RichTextLabel" parent="CenterContainer/ModalPanel/MarginContainer/VBoxContainer/ScrollContainer/ScrollVBox/CourseDataCard/CourseDataVBox"]
layout_mode = 2
theme_override_colors/default_color = Color(0.9, 0.93, 0.96, 1)
theme_override_font_sizes/normal_font_size = 14
bbcode_enabled = true
text = "• [b]OpenStreetMap (ODbL)[/b]: Real-world course layouts, hole geometries, satellite vectors, and terrain data are dynamically retrieved from the [url=https://www.openstreetmap.org/]OpenStreetMap[/url] project. OpenStreetMap data is licensed under the [b]Open Data Commons Open Database License 1.0 (ODbL)[/b] by the OpenStreetMap Foundation. © [url=https://www.openstreetmap.org/copyright]OpenStreetMap contributors[/url].

• [b]Elevation Sources[/b]: Terrain elevations are derived from public domain US Geological Survey (USGS 3DEP) data and AWS Terrain Tiles / Mapzen Terrarium open geodata.

• [b]Course Names & Geographic Realism[/b]: Real-world golf course routings, tee boxes, and yardages represent factual geographic information. Names of golf clubs, resorts, and courses are queried directly from open geographic databases and used purely as factual geographic location references. Heckle Golf Simulator has no affiliation with or endorsement from any golf club, resort, course designer, or governing body (such as the USGA, The R&A, or the PGA TOUR)."
fit_content = true

