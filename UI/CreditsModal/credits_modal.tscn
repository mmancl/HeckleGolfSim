[node name="AboutTitle" type="Label" parent="CenterContainer/ModalPanel/MarginContainer/VBoxContainer/ScrollContainer/ScrollVBox/AboutCard/AboutVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.4, 0.85, 0.55, 1)
theme_override_font_sizes/font_size = 18
text = "⛳ The Story & Personal Project"

[node name="AboutText" type="RichTextLabel" parent="CenterContainer/ModalPanel/MarginContainer/VBoxContainer/ScrollContainer/ScrollVBox/AboutCard/AboutVBox"]
layout_mode = 2
theme_override_colors/default_color = Color(0.9, 0.93, 0.96, 1)
theme_override_font_sizes/normal_font_size = 14
bbcode_enabled = true
text = "Heckle Golf Simulator is an open-source personal project born out of two big passions:

• [b]More Courses & Freedom[/b]: I wanted a virtually unlimited selection of real-world courses for myself to practice and play with my personal launch monitor, and figured fellow simulator golfers would love to enjoy them too!
• [b]Classic PS2 Announcer Roasts[/b]: I grew up loving classic arcade golf games on the PlayStation 2 where witty announcers would relentlessly roast and make fun of your terrible shots, duffs, hooks, and wormburners. Heckle Golf is bringing that unique humor, personality, and heckling commentary back into golf simulation!

• [b]Hardware & Device Testing[/b]: I personally own and test with a Square Golf launch monitor. While connection protocols for other devices (such as GSPro Open Connect v1 and PiTrac over TCP) are implemented, I cannot physically test hardware I do not own. Adjustments and improvements are continuously made based on community feedback!
• [b]Development Pace[/b]: I am only able to physically test about once a week, so development progresses incrementally, but I am committed to improving the simulator and responding to feedback.

Any feedback, bug reports, feature suggestions, or community contributions are awesome and warmly welcomed."
fit_content = true

