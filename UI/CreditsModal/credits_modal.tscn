[node name="AttrTitle" type="Label" parent="CenterContainer/ModalPanel/MarginContainer/VBoxContainer/ScrollContainer/ScrollVBox/AttributionsCard/AttrVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.75, 0.35, 1)
theme_override_font_sizes/font_size = 18
text = "📜 Built With & Special Thanks"

[node name="AttrText" type="RichTextLabel" parent="CenterContainer/ModalPanel/MarginContainer/VBoxContainer/ScrollContainer/ScrollVBox/AttributionsCard/AttrVBox"]
layout_mode = 2
theme_override_colors/default_color = Color(0.9, 0.93, 0.96, 1)
theme_override_font_sizes/normal_font_size = 14
bbcode_enabled = true
text = "• [b]Godot Engine[/b] ([url=https://godotengine.org/]godotengine.org[/url]) - High-performance open-source 2D & 3D game engine (C# / .NET).
• [b]OpenFairway[/b] ([url=https://github.com/jesseincode/OpenFairway]github.com/jesseincode/OpenFairway[/url]) - Realistic Reynolds-number golf ball aerodynamics and rollout physics engine by Jesse Inman / Jakobi.
• [b]OpenStreetMap[/b] ([url=https://www.openstreetmap.org/]openstreetmap.org[/url]) - Global course layouts, satellite vectors, and terrain elevation data © OpenStreetMap contributors (ODbL).
• [b]Jolt Physics 3D[/b] ([url=https://github.com/jrouwe/JoltPhysics]github.com/jrouwe/JoltPhysics[/url]) - Advanced 3D physics and collision solver by Jorrit Rouwe.
• [b]Google MediaPipe[/b] ([url=https://developers.google.com/mediapipe]developers.google.com/mediapipe[/url]) - Real-time on-device golfer pose estimation & swing tempo analysis.
• [b]PiTrac & GSPro Open Connect v1[/b] - Launch monitor packet specification & socket networking protocols.
• [b]Community Addons[/b] - Sky3D, Terrain3D, and Phantom Camera for dynamic environments and follow cams."
fit_content = true

