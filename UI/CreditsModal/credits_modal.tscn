[node name="AboutText" type="RichTextLabel" parent="CenterContainer/ModalPanel/MarginContainer/VBoxContainer/ScrollContainer/ScrollVBox/AboutCard/AboutVBox"]
layout_mode = 2
theme_override_colors/default_color = Color(0.9, 0.93, 0.96, 1)
theme_override_font_sizes/normal_font_size = 14
bbcode_enabled = true
text = "Heckle Golf Simulator is an open-source personal project born out of two big passions:

• [b]More Courses & Freedom[/b]: I wanted a virtually unlimited selection of real-world courses for myself to practice and play with the Square Golf launch monitor, and figured fellow simulator golfers would love to enjoy them too!
• [b]Classic PS2 Announcer Roasts[/b]: I grew up loving classic arcade golf games on the PlayStation 2 where witty announcers would relentlessly roast and make fun of your terrible shots, duffs, hooks, and wormburners. Heckle Golf is bringing that unique humor, personality, and heckling commentary back into golf simulation!

Any feedback, bug reports, feature suggestions, or community contributions are awesome and warmly welcomed."
fit_content = true

[node name="AboutBtnHBox" type="HBoxContainer" parent="CenterContainer/ModalPanel/MarginContainer/VBoxContainer/ScrollContainer/ScrollVBox/AboutCard/AboutVBox"]
layout_mode = 2

