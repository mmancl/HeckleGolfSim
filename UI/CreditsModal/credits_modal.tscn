[node name="AttrTitle" type="Label" parent="CenterContainer/ModalPanel/MarginContainer/VBoxContainer/ScrollContainer/ScrollVBox/AttributionsCard/AttrVBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.95, 0.75, 0.35, 1)
theme_override_font_sizes/font_size = 18
text = "📜 Built With, Addons & Asset Attributions"

[node name="AttrText" type="RichTextLabel" parent="CenterContainer/ModalPanel/MarginContainer/VBoxContainer/ScrollContainer/ScrollVBox/AttributionsCard/AttrVBox"]
layout_mode = 2
theme_override_colors/default_color = Color(0.9, 0.93, 0.96, 1)
theme_override_font_sizes/normal_font_size = 14
bbcode_enabled = true
text = "Heckle Golf Simulator is built using outstanding open-source technologies, libraries, and creative commons assets:

• [b]Godot Engine[/b] ([url=https://godotengine.org/]godotengine.org[/url]) - High-performance open-source 2D & 3D game engine (MIT License). Copyright © 2014-present Godot Engine contributors; Copyright © 2007-2014 Juan Linietsky, Ariel Manzur.
• [b]OpenFairway[/b] ([url=https://github.com/jesseincode/OpenFairway]github.com/jesseincode/OpenFairway[/url]) - Realistic Reynolds-number golf ball aerodynamics and rollout physics engine by Jesse Inman / Jakobi (MIT License).
• [b]Jolt Physics 3D[/b] ([url=https://github.com/jrouwe/JoltPhysics]github.com/jrouwe/JoltPhysics[/url]) - Advanced 3D physics and collision solver by Jorrit Rouwe (MIT License).
• [b]Google MediaPipe & TensorFlow.js[/b] ([url=https://developers.google.com/mediapipe]developers.google.com/mediapipe[/url]) - Golfer skeleton pose estimation & swing tempo analysis (Apache License 2.0). Copyright © Google LLC.
• [b]Sky3D Dynamic Environment[/b] ([url=https://github.com/CoryPetkovsek/godot-sky3d]github.com/CoryPetkovsek/godot-sky3d[/url]) - Procedural sky and atmosphere system by Cory Petkovsek and J. Cuéllar (MIT License).
  — [i]Milky Way Texture[/i]: \"The Milky Way panorama\" by ESO/S. Brunier, licensed under [url=https://creativecommons.org/licenses/by/4.0/]CC BY 4.0[/url] and used in original and modified forms ([url=https://www.eso.org/public/images/eso0932a/]ESO Archive[/url]).
  — [i]Moon Texture[/i]: Copyright © 2019 GPoSM (MIT License).
• [b]Terrain3D[/b] ([url=https://github.com/CoryPetkovsek/godot-terrain3d]github.com/CoryPetkovsek/godot-terrain3d[/url]) - High-performance editable terrain system by Cory Petkovsek, Roope Palmroos, and Contributors (MIT License).
• [b]Phantom Camera[/b] ([url=https://github.com/ramok/phantom-camera]github.com/ramok/phantom-camera[/url]) - Dynamic camera controls by Marcus Skov (MIT License).
• [b]PBR Textures & 3D Foliage[/b] - Materials sourced from [url=https://ambientcg.com/]ambientCG.com[/url] and Shapespark low-poly plants, dedicated to the public domain under [url=https://creativecommons.org/publicdomain/zero/1.0/]Creative Commons CC0 1.0 Universal[/url].
• [b]OpenStreetMap Geodata[/b] ([url=https://www.openstreetmap.org/]openstreetmap.org[/url]) - Real-world course layouts and terrain vectors © [url=https://www.openstreetmap.org/copyright]OpenStreetMap contributors[/url] (Open Database License ODbL 1.0)."
fit_content = true

