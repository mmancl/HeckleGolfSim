# Godot 4+ specific ignores
.godot/
/android/build/
!/android/plugins/
# Godot-specific ignores
.import/
export.cfg
export_credentials.cfg

# Imported translations
*.translation

# Mono-specific ignores
.mono/
data_*/
mono_crash.*.json
OpenShotGolf.Tests/bin/
OpenShotGolf.Tests/obj/

# IDE Specific, used for code analytics outside of Godot IDE. 
.vscode

*addons/terrain_3d/bin/*

*.claude
*.codex
*.agents
android_old/build/

# MediaPipe model files (downloaded on-demand, ~30MB each)
*.task
__pycache__/
*.pyc

# Ignore large binary files
*.scn